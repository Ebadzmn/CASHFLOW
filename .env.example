# =====================================================
# CashFlow Monorepo — Environment Variables Template
# Copy this to .env and fill in your real values
# NEVER commit .env to git!
# =====================================================

# ----------------------app start---------------------------
# Flutter reads these at build time via --dart-define
FLUTTER_API_BASE_URL=http://10.0.2.2:5000/api/v1
FLUTTER_SOCKET_URL=http://10.0.2.2:5000
# ----------------------app end-----------------------------


# ----------------------admin start---------------------------
# Next.js Admin Dashboard (port 3001)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret_here
# ----------------------admin end-----------------------------


# ----------------------backend start---------------------------
NODE_ENV=development
SESSION_MAX_AGE_MS=86400000
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<db>?retryWrites=true&w=majority

IP_ADDRESS=0.0.0.0
PORT=5000
DATABASE_SERVER_SELECTION_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:3001
SOCKET_PING_TIMEOUT_MS=60000

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRE_IN=90d

# Email
EMAIL_FROM=your@email.com
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com

# Brand Logo
BRAND_LOGO_URL=https://your-logo-url.com/logo.png

# Stripe
STRIPE_API_SECRET=
WEBHOOK_SECRET=
SUCCESS_URL=http://localhost:3001

# Admin Credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_secure_password

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FCM_SERVER_KEY=
SENDER_ID=
FCM_SERVICE_ACCOUNT_BASE64=

# Apple In-App Purchase
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=com.yourapp.bundle
APPLE_APP_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_ROOT_CERTIFICATE_PATHS=certs/apple/AppleIncRootCertificate.cer,certs/apple/AppleRootCA-G2.cer,certs/apple/AppleRootCA-G3.cer
APPLE_PRODUCT_MAP={}

# Google Play In-App Purchase
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_PACKAGE_NAME=

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/v1/oauth/google/callback

# Session
SESSION_SECRET=your_session_secret_key

# Frontend OAuth Redirect
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3001/auth/callback

# PayPal (web payments)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe (web payments)
STRIPE_SECRET_KEY=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=your-bucket-name
AWS_REGION=ap-southeast-1

# CloudFront
CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net
# ----------------------backend end---------------------------


# ----------------------Turborepo (optional)---------------------------
# Enable Vercel Remote Cache for faster CI builds
# TURBO_TOKEN=your_vercel_token
# TURBO_TEAM=your_team_slug
# ----------------------Turborepo end---------------------------
